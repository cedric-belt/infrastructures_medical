│   └── deployment.md
├── src/
│   ├── __init__.py
│   ├── app_factory.py
│   ├── config.py
│   ├── database.py
│   ├── models.py
│   ├── routes/
│   │   ├── __init__.py
│   │   ├── health.py
│   │   ├── equipment.py
│   │   └── patients.py
│   └── services/
│       ├── __init__.py
│       ├── equipment_service.py
